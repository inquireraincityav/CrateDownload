    '<div style="color:#8a919c">The background service is stopping and everything ' +
    'is being removed. You can close this window.</div>' +
    '<div style="color:#8a919c;margin-top:18px;font-size:12.5px">Log: ' +
    esc(r.msg) + '</div></div>';
});

