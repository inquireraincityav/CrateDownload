function nowCard(s){
  const n = s.now;
  if(!n){
    const pend = s.submits.filter(x => x.status === "sending").length;
    return `<div class="card"><div class="empty">${pend ? "starting…" :
      "Idle — nothing capturing."}</div></div>`;
  }
  const head = n.track ? esc(n.track) : (n.stage === "next track…" ? "moving to next track…" : "starting…");
  const bits = [];
  if(n.container) bits.push(esc(n.kind||"set") + ": " + esc(n.container));
  if(n.done_count) bits.push(n.done_count + " done this run");
  bits.push("pid " + n.pid);
  const pct = (n.percent === null || n.percent === undefined) ? null : n.percent;
  const bar = pct === null
    ? `<div class="bar indet"><i></i></div>`
    : `<div class="bar"><i style="width:${pct}%"></i></div>
       <div class="times"><span>${mmss(n.elapsed)}</span><span>${pct.toFixed(0)}%</span>
       <span>${mmss(n.duration)}</span></div>`;
  return `<div class="card now"><div class="head"><div class="t">🎙 ${head}</div></div>
    <div class="sub">${bits.join(" · ")}</div>${bar}</div>`;
}

const PILL = {sending:"", queued:"", capturing:"ok", done:"ok", skipped:"warn",
              rejected:"bad", error:"bad"};
function queueCard(s){
  const rows = [];
  const now = Date.now()/1000;
  s.submits.filter(x => x.status !== "capturing" &&
                        (!x.finished || now - x.finished < 300))
    .forEach(x => {
      // A finished or skipped submit carries the file it resolved to, so give
      // it the same reveal button as the Finished list. For a skip that is the
      // only way to see what it matched: the file keeps its original date and
      // may be far too old to show up below.
      const rev = x.path
        ? `<button class="mini" data-file data-reveal="${esc(x.path)}"
             title="Reveal in Finder">&#128269;</button>` : "";
      rows.push(`<div class="row"><div class="n">${esc(x.url)}
        ${x.result ? `<div class="folder">${esc(x.result)}</div>` : ""}</div>
        <span class="pill ${PILL[x.status]||""}">${esc(x.status)}</span>${rev}</div>`);
    });
  s.queue.forEach((q,i) => rows.push(`<div class="row"><div class="n">${esc(q.label || q.url)}</div>
      <span class="m">#${i+1}</span></div>`));
  if(!rows.length) return `<div class="card"><div class="empty">Queue empty.</div></div>`;
  return `<div class="card">${rows.join("")}</div>`;
}

function recentCard(s){
  if(!s.recent.length) return `<div class="card"><div class="empty">Nothing captured yet.</div></div>`;
  const rows = s.recent.map(f => {
    const fresh = f.age < 900 ? `<span class="pill ok">new</span>` : "";
    const fold = f.folder ? `<div class="folder">${esc(f.folder)}/</div>` : "";
    return `<div class="row"><div class="n">${esc(f.name)}${fold}</div>
      ${fresh}<span class="m">${f.mb} MB · ${esc(f.when)}</span>
      <button class="mini" data-file data-reveal="${esc(f.path)}"
        title="Reveal in Finder">&#128269;</button></div>`;
  });
  return `<div class="card">${rows.join("")}</div>`;
}

let failures = 0;
async function tick(){
  try{
    const s = await (await fetch("/api/status")).json();
    failures = 0;
    $("#dot").className = "dot" + (s.capturing ? " live" : "");
    $("#clock").textContent = s.time;
    $("#nowbox").innerHTML = nowCard(s);
    $("#queue").innerHTML  = queueCard(s);
    $("#recent").innerHTML = recentCard(s);
    $("#where").textContent = "files land in " + s.storage_pretty +
      (s.mirrors && s.mirrors.length ? " (+ " + s.mirrors.length + " mirror" +
       (s.mirrors.length > 1 ? "s" : "") + ")" : "");
    document.title = s.capturing
      ? "🎙 " + (s.now && s.now.track ? s.now.track : "capturing") + " — Audio Downloader"
      : "Audio Downloader";
  }catch(e){
    if(++failures > 2) $("#clock").textContent = "app offline";
  }
}
tick(); setInterval(tick, 1500);
</script></body></html>
"""


# ----------------------------------------------------------------- http layer

class Handler(BaseHTTPRequestHandler):
    server_version = "AudioDownloader/1.0"

    def log_message(self, fmt, *a):      # keep stdout clean under launchd
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/status":
            return self._send(200, json.dumps(status_payload()))
        if path == "/api/config":
            return self._send(200, json.dumps(config_payload()))
        if path == "/api/perms":
            return self._send(200, json.dumps(perms_payload()))
        if path == "/health":
            return self._send(200, "ok", "text/plain")
        self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        path = urlparse(self.path).path
        try:
            n = int(self.headers.get("Content-Length") or 0)
            payload = json.loads(self.rfile.read(n) or b"{}") if n else {}
        except (ValueError, json.JSONDecodeError):
            payload = {}
        if path == "/api/add":
            res = submit(payload.get("text", ""))
            return self._send(200, json.dumps({"added": res}))
        if path == "/api/reveal":
            tgt = payload.get("path") or str(STORAGE)
            ok, msg = reveal(tgt, select=bool(payload.get("select", True)))
            return self._send(200, json.dumps({"ok": ok, "msg": msg}))
        if path == "/api/pick":
            # The Finder panel opens on the Mac's screen, so a request from
            # anywhere else would pop a dialog nobody can see. Loopback only.
            if self.client_address[0] not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
                return self._send(200, json.dumps(
                    {"ok": False, "msg": "open this page on the Mac to browse"}))
            ok, res = pick_path(payload.get("mode") or "folder",
                                payload.get("start") or "")
            return self._send(200, json.dumps(
                {"ok": ok, "path": res if ok else "", "msg": "" if ok else res}))
        if path == "/api/config":
            ok, msg, restart = config_save(payload.get("values") or {})
            if ok and restart and payload.get("restart", True):
                self._send(200, json.dumps({"ok": ok, "msg": msg + " — restarting",
                                            "restart": True}))
                self_restart()
                return
            return self._send(200, json.dumps({"ok": ok, "msg": msg, "restart": False}))
        if path == "/api/perms/open":
            ok, msg = perms_open(payload.get("key") or "")
            return self._send(200, json.dumps({"ok": ok, "msg": msg}))
        if path == "/api/perms/check":
            return self._send(200, json.dumps(
                perms_payload(active=payload.get("key") or None)))
        if path == "/api/perms/dismiss":
            _setup_write({"dismissed": bool(payload.get("dismissed", True))})
            return self._send(200, json.dumps({"ok": True}))
        if path == "/api/uninstall":
            # There is no authentication on this server. It binds loopback by
            # default, but the host is configurable, so the one destructive
            # endpoint refuses anything that is not local regardless.
            #
            # The message matters. When this page was reachable at a LAN
            # address, opening it there and clicking Uninstall *at the Mac*
            # arrived from the LAN IP and got told to "run it on the Mac
            # itself" — technically true, unactionable, and infuriating. Name
            # the actual problem: the page, not the person.
            if self.client_address[0] not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
                applog(f"uninstall refused from {self.client_address[0]}")
                return self._send(200, json.dumps(
                    {"ok": False,
                     "msg": (f"this page is open at a network address "
                             f"({self.client_address[0]}). Reopen the app, or go to "
                             f"http://localhost:{PORT}, and try again.")}))
            # Typed confirmation, not just a button press: this is the one
            # action in the app that cannot be undone from inside the app.
            if (payload.get("confirm") or "").strip().upper() != "UNINSTALL":
                return self._send(200, json.dumps(
                    {"ok": False, "msg": "type UNINSTALL to confirm"}))
            ok, msg = uninstall_spawn(bool(payload.get("purge_music")),
                                      bool(payload.get("remove_deps")))
            return self._send(200, json.dumps({"ok": ok, "msg": msg}))
        if path == "/api/stop":
            try:
                r = subprocess.run(RECORD_AUDIO_CMD + ["stop"],
                                   capture_output=True, text=True, timeout=45)
                applog(f"stop -> rc={r.returncode} {r.stdout.strip()!r}")
                return self._send(200, json.dumps({"ok": True, "out": r.stdout.strip()}))
            except Exception as e:
                return self._send(200, json.dumps({"ok": False, "out": f"{type(e).__name__}: {e}"}))
        self._send(404, json.dumps({"error": "not found"}))


class DualStackServer(ThreadingHTTPServer):
    """Bind :: with V6ONLY off so one socket answers IPv4 *and* IPv6.

    Only reachable by setting server.host to a wildcard, which is not the
    default. Kept because a host with both an A and an AAAA record resolves
    to the AAAA first on some clients, and an IPv4-only bind then looks dead
    at the hostname while the raw IPv4 address works.
    """

    address_family = socket.AF_INET6

    def server_bind(self):
        try:
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        except OSError:
            pass
        return super().server_bind()


def main():
    if not RECORD_AUDIO.exists():
        raise SystemExit(f"record-audio not found at {RECORD_AUDIO}")
    applog(f"config: {CFG.path}  storage: {STORAGE}")
    threading.Thread(target=watch_submits, daemon=True).start()
    ThreadingHTTPServer.allow_reuse_address = True
    # Loopback (the default) is a plain IPv4 bind. The dual-stack socket is
    # only for the wildcard case, which nothing ships with -- see the class.
    if HOST in ("0.0.0.0", "::", ""):
        try:
            srv = DualStackServer(("::", PORT), Handler)
        except OSError:
            srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    else:
        srv = ThreadingHTTPServer((HOST, PORT), Handler)
    applog(f"audio-downloader listening on {HOST}:{PORT}")
    print(f"audio-downloader → http://localhost:{PORT}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
