#!/usr/bin/env python3
"""audio-downloader — local capture app (Sidify-style) for Spotify / YouTube / SoundCloud.

Serves a single-page web app on localhost. Paste or drop a track / album /
playlist link and it fires `record-audio <url>` — the same capture engine
every other entry point uses. No LLM, no network calls to anything but the
Mac itself, and nothing listens beyond this machine.

Everything machine-specific comes from adcfg (see adcfg.py). State it reads,
all written by record-audio and never by this app:
  <state_dir>/record-audio.pid   — capture in flight
  <state_dir>/rec-queue.json     — pending URLs
  <log_file>                     — per-track progress lines

Env: AUDIO_DOWNLOADER_CONFIG, AUDIO_DOWNLOADER_PORT, AUDIO_DOWNLOADER_HOST,
     AUDIO_DOWNLOADER_LABEL (the launchd job to kickstart on a settings save)
"""
from __future__ import annotations

import json
import os
import re
import socket
import ctypes
import ctypes.util
import subprocess
import sys
import threading
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs

sys.path.insert(0, str(Path(__file__).resolve().parent))
import adcfg  # noqa: E402  (shared config layer — see adcfg.py)

CFG = adcfg.SETTINGS
CFG.ensure_dirs()

HOME = Path.home()
RECORD_AUDIO = Path(__file__).resolve().parent / "record-audio"
# Always spawn the engine as [interpreter, script] rather than relying on its
# shebang. The default install path contains a space ("Application Support"),
# which a shebang cannot express — the kernel splits on the first whitespace,
# and the failure then reads as ENOENT on the script itself, which is
# thoroughly misleading. Naming the interpreter sidesteps the whole problem.
RECORD_AUDIO_CMD = [sys.executable, str(RECORD_AUDIO)]
STORAGE = CFG.storage
STATE_DIR = CFG.state_dir
PIDFILE = STATE_DIR / "record-audio.pid"
QUEUEFILE = STATE_DIR / "rec-queue.json"
LOGFILE = CFG.log_file
APPLOG = STATE_DIR / "audio-downloader.log"

PORT = CFG.port
HOST = CFG.host

# Audio extensions the "Finished" list surfaces. mp3 is what record-audio
# produces today; the rest are here so a reconfigured engine still shows up.
AUDIO_EXTS = (".mp3", ".m4a", ".wav", ".aiff", ".flac", ".opus")

URL_RE = re.compile(r"(https?://[^\s<>\"']+|spotify:[a-z]+:[A-Za-z0-9]+)")
ALLOWED = (
    "open.spotify.com", "spotify.link",
    "youtube.com", "www.youtube.com", "m.youtube.com", "music.youtube.com", "youtu.be",
    "soundcloud.com", "www.soundcloud.com", "m.soundcloud.com", "on.soundcloud.com",
)
SPOTIFY_KIND_RE = re.compile(
    r"open\.spotify\.com/(?:intl-[a-z]{2}/)?(track|album|playlist)/|spotify:(track|album|playlist):"
)
LOGLINE_RE = re.compile(r"^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\] \[record-audio\] (.*)$")
START_RE = re.compile(r"^spotify capture starting: (.+?) id=(\S*) dur=(\d+)ms$")
DONE_RE = re.compile(r"^spotify capture done: (.+)$")
SKIP_RE = re.compile(r"^spotify capture skip \(already exists, duration-verified\): (.+)$")
FOLDER_RE = re.compile(r"^spotify (track|album|playlist) folder: (.+)$")
NN_RE = re.compile(r"^\d{2} - ")


def applog(msg: str) -> None:
    try:
        with open(APPLOG, "a") as f:
            f.write(f"[{datetime.now():%Y-%m-%d %H:%M:%S}] {msg}\n")
    except OSError:
        pass


# ---------------------------------------------------------------- engine state

def pid_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def current_pid():
    try:
        pid = int(PIDFILE.read_text().strip())
    except (OSError, ValueError):
        return None
    return pid if pid_running(pid) else None


def queue_load():
    try:
        return json.loads(QUEUEFILE.read_text())
    except (OSError, json.JSONDecodeError):
        return []


def session_start() -> float:
    try:
        return PIDFILE.stat().st_mtime - 3.0
    except OSError:
        return time.time()


def read_log_lines(limit_bytes: int = 262144):
    """Return [(epoch, msg)] for record-audio lines in the log tail."""
    try:
        size = LOGFILE.stat().st_size
        with open(LOGFILE, "rb") as f:
            if size > limit_bytes:
                f.seek(size - limit_bytes)
                f.readline()
            raw = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    out = []
    for line in raw.splitlines():
        m = LOGLINE_RE.match(line)
        if not m:
            continue
        try:
            ts = datetime.strptime(m.group(1), "%Y-%m-%d %H:%M:%S").timestamp()
        except ValueError:
            continue
        out.append((ts, m.group(2)))
    return out


def pretty_title(path_str: str) -> str:
    stem = Path(path_str).stem
    return NN_RE.sub("", stem)


def capture_progress():
    """Derive what's happening right now from record-audio's own log lines."""
    pid = current_pid()
    if not pid:
        return None
    t0 = session_start()
    lines = [(ts, m) for ts, m in read_log_lines() if ts >= t0]
    info = {
        "pid": pid,
        "container": None,
        "kind": None,
        "track": None,
        "elapsed": None,
        "duration": None,
        "percent": None,
        "done_count": 0,
        "stage": "starting",
    }
    started = None
    done_paths, skip_paths = set(), set()
    for ts, msg in lines:
        m = FOLDER_RE.match(msg)
        if m:
            info["kind"] = m.group(1)
            info["container"] = Path(m.group(2)).name
            continue
        m = START_RE.match(msg)
        if m:
            started = (ts, m.group(1), int(m.group(3)) / 1000.0)
            continue
        m = DONE_RE.match(msg)
        if m:
            done_paths.add(m.group(1))
            continue
        m = SKIP_RE.match(msg)
        if m:
            skip_paths.add(m.group(1))
            continue
        if msg.startswith("yt-dlp"):
            info["stage"] = "downloading"
    info["done_count"] = len(done_paths | skip_paths)
    if started:
        ts, path, dur = started
        if path in done_paths:
            info["stage"] = "next track…"
            info["track"] = None
        else:
            elapsed = max(0.0, time.time() - ts)
            info["stage"] = "capturing"
            info["track"] = pretty_title(path)
            info["path"] = path
            info["elapsed"] = round(elapsed, 1)
            info["duration"] = round(dur, 1)
            info["percent"] = round(min(100.0, elapsed / dur * 100.0), 1) if dur > 0 else None
    return info


_recent_cache = {"t": 0.0, "v": []}


def recent_files(n: int = 14):
    if time.time() - _recent_cache["t"] < 3.0:
        return _recent_cache["v"]
    rows = []
    try:
        for p in STORAGE.rglob("*"):
            if p.suffix.lower() not in AUDIO_EXTS or not p.is_file():
                continue
            try:
                st = p.stat()
            except OSError:
                continue
            rows.append((st.st_mtime, st.st_size, p))
    except OSError:
        rows = []
    rows.sort(reverse=True, key=lambda r: r[0])
    out = []
    for mtime, size, p in rows[:n]:
        rel = p.relative_to(STORAGE)
        out.append({
            "name": pretty_title(p.name),
            "folder": str(rel.parent) if str(rel.parent) != "." else "",
            "mb": round(size / 1_000_000, 1),
            "when": datetime.fromtimestamp(mtime).strftime("%b %-d, %-I:%M %p"),
            "age": time.time() - mtime,
            "path": str(p),
            "dir": str(p.parent),
        })
    _recent_cache.update(t=time.time(), v=out)
    return out


def reveal(target: str, select: bool = True):
    """Open Finder at `target`. Jailed to the configured storage dir so an
    open port on the LAN/tailnet can't be used to poke around the filesystem.
    Returns (ok, message)."""
    try:
        p = Path(target).expanduser().resolve()
    except (OSError, RuntimeError) as e:
        return False, f"bad path: {e}"
    try:
        root = STORAGE.resolve()
    except OSError:
        root = STORAGE
    allowed = p == root or root in p.parents
    if not allowed:
        # the config file (and the folder holding it) is the one thing outside
        # the capture dir the UI may point Finder at -- the Settings panel
        # needs an "open my config" affordance.
        try:
            cfg = CFG.path.resolve()
            allowed = p in (cfg, cfg.parent)
        except OSError:
            allowed = False
    if not allowed:
        applog(f"reveal REFUSED (outside storage): {p}")
        return False, "path is outside the capture folder"
    if not p.exists():
        return False, "file is no longer there"
    cmd = ["/usr/bin/open", "-R", str(p)] if (select and p.is_file()) else ["/usr/bin/open", str(p)]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return False, (r.stderr or "").strip()[:200] or f"rc={r.returncode}"
        applog(f"reveal {p}")
        return True, "opened in Finder"
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"


def pick_path(mode, start):
    """Native Finder chooser. Returns (ok, posix path) or (False, message).

    `choose folder`/`choose file` need a real GUI session, so this runs via
    osascript against System Events and comes back as a POSIX path, not an
    HFS alias string. Cancel is rc=1 with "User canceled" -- not an error
    worth shouting about, so it returns quietly.
    """
    d = ""
    try:
        p = Path(os.path.expanduser(start or "")).expanduser()
        if mode == "file":
            p = p.parent
        while p != p.parent and not p.is_dir():
            p = p.parent
        if p.is_dir():
            d = f'default location POSIX file "{str(p)}" '
    except Exception:
        d = ""
    verb = "choose file" if mode == "file" else "choose folder"
    scpt = (f'tell application "System Events" to activate\n'
            f'set f to {verb} with prompt "Choose a '
            f'{"file" if mode == "file" else "folder"}" {d}\n'
            f'return POSIX path of f')
    try:
        r = subprocess.run(["osascript", "-e", scpt],
                           capture_output=True, text=True, timeout=180)
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"
    if r.returncode != 0:
        err = (r.stderr or "").strip()
        if "-128" in err or "cancel" in err.lower():
            return False, ""
        return False, err[:160] or f"rc={r.returncode}"
    out = (r.stdout or "").strip().rstrip("/")
    if not out:
        return False, ""
    applog(f"pick {mode} -> {out}")
    return True, out



# ------------------------------------------------------------- permissions
# First-run setup. macOS privacy permissions (TCC) cannot be granted
# programmatically -- not even as root, SIP owns that database. What we CAN
# do is tell the user exactly which three switches matter, check each one
# honestly, and deep-link straight to the pane instead of making them hunt.

SETUP_STATE = CFG.path.parent / "setup_state.json"

PERMS = [
    ("screen", "Screen Recording",
     "Spotify captures are recorded off the app's own audio stream. macOS files "
     "that under Screen Recording even though no video is touched.",
     "Privacy_ScreenCapture"),
    ("mic", "Microphone",
     "The raw-capture path taps the BlackHole input device. macOS treats every "
     "audio input as a microphone.",
     "Privacy_Microphone"),
    ("spotify", "Automation ▸ Spotify",
     "Lets the app start, stop and read the current track in Spotify so captures "
     "line up with track boundaries.",
     "Privacy_Automation"),
]

_PERM_PANE = {k: pane for k, _l, _h, pane in PERMS}


def _tcc_screen():
    try:
        cg = ctypes.CDLL(ctypes.util.find_library("CoreGraphics"))
        cg.CGPreflightScreenCaptureAccess.restype = ctypes.c_bool
        return "ok" if cg.CGPreflightScreenCaptureAccess() else "denied"
    except Exception as e:
        applog(f"perm screen check failed: {type(e).__name__}: {e}")
        return "unknown"


def _tcc_mic():
    # AVCaptureDevice.authorizationStatusForMediaType(.audio) via the objc
    # runtime -- system python has no pyobjc, and this never prompts.
    try:
        objc = ctypes.CDLL(ctypes.util.find_library("objc"))
        ctypes.CDLL(ctypes.util.find_library("AVFoundation"))
        objc.objc_getClass.restype = ctypes.c_void_p
        objc.objc_getClass.argtypes = [ctypes.c_char_p]
        objc.sel_registerName.restype = ctypes.c_void_p
        objc.sel_registerName.argtypes = [ctypes.c_char_p]
        send = objc.objc_msgSend
        send.restype = ctypes.c_void_p
        send.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_char_p]
        media = send(objc.objc_getClass(b"NSString"),
                     objc.sel_registerName(b"stringWithUTF8String:"), b"soun")
        send.restype = ctypes.c_long
        send.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
        v = send(objc.objc_getClass(b"AVCaptureDevice"),
                 objc.sel_registerName(b"authorizationStatusForMediaType:"), media)
        return {0: "unknown", 1: "denied", 2: "denied", 3: "ok"}.get(int(v), "unknown")
    except Exception as e:
        applog(f"perm mic check failed: {type(e).__name__}: {e}")
        return "unknown"


def _tcc_spotify(active=False):
    """Automation-for-Spotify. Passive checks are cached, because the only
    honest probe is an actual Apple Event -- and that launches Spotify if it
    isn't running. So the passive path reports the last known answer and the
    Check button does the real thing."""
    if not active:
        try:
            return json.loads(SETUP_STATE.read_text()).get("spotify", "unknown")
        except Exception:
            return "unknown"
    scpt = 'tell application id "com.spotify.client" to return player state as text'
    try:
        r = subprocess.run(["osascript", "-e", scpt],
                           capture_output=True, text=True, timeout=60)
    except Exception as e:
        applog(f"perm spotify probe failed: {type(e).__name__}: {e}")
        return "unknown"
    err = (r.stderr or "")
    if r.returncode == 0:
        res = "ok"
    elif "-1743" in err or "Not authorized" in err or "not allowed" in err:
        res = "denied"
    elif "-1728" in err or "-600" in err:
        # reachable but odd reply -- the Apple Event itself got through,
        # which is the thing being tested.
        res = "ok"
    else:
        applog(f"perm spotify probe rc={r.returncode} {err.strip()[:160]!r}")
        res = "unknown"
    _setup_write({"spotify": res})
    return res


def _setup_read():
    try:
        return json.loads(SETUP_STATE.read_text())
    except Exception:
        return {}


def _setup_write(patch):
    d = _setup_read()
    d.update(patch)
    try:
        SETUP_STATE.parent.mkdir(parents=True, exist_ok=True)
        SETUP_STATE.write_text(json.dumps(d, indent=2))
    except Exception as e:
        applog(f"setup_state write failed: {type(e).__name__}: {e}")
    return d


def perms_payload(active=None):
    st = _setup_read()
    checks = {"screen": _tcc_screen, "mic": _tcc_mic,
              "spotify": lambda: _tcc_spotify(active == "spotify")}
    items = []
    for key, label, help_, _pane in PERMS:
        items.append({"key": key, "label": label, "help": help_,
                      "status": checks[key]()})
    allok = all(i["status"] == "ok" for i in items)
    return {"items": items, "all_ok": allok,
            "dismissed": bool(st.get("dismissed")),
            "show": not (allok or st.get("dismissed"))}


def perms_open(key):
    pane = _PERM_PANE.get(key)
    if not pane:
        return False, "unknown pane"
    url = f"x-apple.systempreferences:com.apple.preference.security?{pane}"
    try:
        subprocess.run(["/usr/bin/open", url], capture_output=True,
                       text=True, timeout=15)
        applog(f"opened settings pane {pane}")
        return True, "System Settings opened"
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"


# ------------------------------------------------------------------ settings

# Every key the UI is allowed to touch. (json path, kind, label, help)
EDITABLE = [
    ("storage_dir",          "path",   "Capture folder",
     "Where finished tracks land."),
    ("mirrors.captures",     "path?",  "Mirror — captures",
     "Optional second copy of Spotify captures. Blank = off."),
    ("mirrors.downloads",    "path?",  "Mirror — downloads",
     "Optional second copy of YouTube/SoundCloud rips. Blank = off."),
    ("state_dir",            "path",   "Working folder",
     "Queue, pid file and temp segments."),
    ("log_file",             "path",   "Log file",
     "Engine log. The progress bar is parsed out of this."),
    ("silent_output_device", "device", "Silent device",
     "Output the Mac is parked on while capturing, so nothing hits the speakers."),
    ("multi_output_name",    "text",   "Multi-output name",
     "Aggregate device built for raw (non-Spotify) captures."),
    ("server.port",          "int",    "Port",
     "Web UI port. Changing it restarts the app."),
]

_NEEDS_RESTART = {"state_dir", "log_file", "server.port"}


def _dig(d, dotted, default=None):
    cur = d
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


def _plant(d, dotted, value):
    parts = dotted.split(".")
    cur = d
    for part in parts[:-1]:
        nxt = cur.get(part)
        if not isinstance(nxt, dict):
            nxt = {}
            cur[part] = nxt
        cur = nxt
    cur[parts[-1]] = value


def output_devices():
    """Names of every output device SwitchAudioSource can see."""
    try:
        r = subprocess.run([CFG.switch, "-a", "-t", "output"],
                           capture_output=True, text=True, timeout=8)
        return [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]
    except Exception:
        return []


def config_raw() -> dict:
    """The on-disk JSON exactly as written (not merged with defaults), so a
    save never silently bakes every default into the user's file."""
    try:
        return json.loads(CFG.path.read_text())
    except (OSError, ValueError):
        return {}


def config_payload():
    raw = config_raw()
    merged = adcfg.load(write_if_missing=False)
    fields = []
    for key, kind, label, help_ in EDITABLE:
        val = _dig(raw, key, None)
        if val is None:
            val = _dig(merged, key, "")
        fields.append({
            "key": key, "kind": kind, "label": label, "help": help_,
            "value": "" if val is None else str(val),
            "resolved": pretty_path(_dig(merged, key, "") or ""),
        })
    return {
        "path": str(CFG.path),
        "fields": fields,
        "devices": output_devices(),
        "notice": "Paths accept ~ and $VARS. Saving rewrites only the keys you changed.",
    }


def config_save(values: dict):
    """Validate + merge into the config file. Returns (ok, msg, restart)."""
    raw = config_raw()
    spec = {k: (kind, label) for k, kind, label, _ in EDITABLE}
    changed, restart = [], False
    for key, newval in (values or {}).items():
        if key not in spec:
            continue
        kind, label = spec[key]
        v = (newval or "").strip() if isinstance(newval, str) else newval

        if kind == "int":
            try:
                v = int(str(v))
            except ValueError:
                return False, f"{label}: not a number", False
            if not (1024 <= v <= 65535):
                return False, f"{label}: must be 1024-65535", False
        elif kind in ("path", "path?"):
            if not v:
                if kind == "path":
                    return False, f"{label}: cannot be blank", False
                v = None
            else:
                probe = Path(os.path.expandvars(os.path.expanduser(str(v))))
                # log_file names a file; every other path key names a folder
                mk = probe.parent if key == "log_file" else probe
                try:
                    mk.mkdir(parents=True, exist_ok=True)
                except OSError as e:
                    return False, f"{label}: cannot create ({e.strerror})", False
                if not os.access(mk, os.W_OK):
                    return False, f"{label}: not writable", False
        elif kind == "device":
            devs = output_devices()
            if devs and v not in devs:
                return False, f"{label}: no output device called {v!r}", False
        elif kind == "text":
            if not v:
                return False, f"{label}: cannot be blank", False

        if _dig(raw, key, None) != v:
            _plant(raw, key, v)
            changed.append(key)
            if key in _NEEDS_RESTART:
                restart = True

    if not changed:
        return True, "nothing changed", False
    try:
        CFG.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = CFG.path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(raw, indent=2) + "\n")
        tmp.replace(CFG.path)
    except OSError as e:
        return False, f"could not write config: {e}", False
    applog(f"config saved: {', '.join(changed)}")
    # The engine re-reads the file on every invocation, so record-audio picks
    # changes up immediately. This process cached its own copy at import.
    return True, f"saved {len(changed)} setting{'s' if len(changed) != 1 else ''}", True


def uninstall_spawn(purge_music=False, remove_deps=False):
    """Hand the uninstall off to a detached copy of the installer script.

    Two reasons it cannot run in place. The script removes the directory it
    lives in, and bash reads a script incrementally — deleting it mid-run
    truncates execution at an arbitrary line. And the very first thing it does
    is stop this launchd job, which kills whatever it was started from, so it
    has to be in its own session with no parent left to take it down.
    """
    import shutil
    import tempfile

    src = CFG.path.parent / "install.sh"
    if not src.exists():
        return False, (f"no uninstaller found at {src} — run install.sh "
                       "--uninstall from the kit folder instead")

    tmpdir = tempfile.mkdtemp(prefix="ad-uninstall-")
    script = Path(tmpdir) / "uninstall.sh"
    shutil.copy2(src, script)
    script.chmod(0o755)

    argv = ["/bin/bash", str(script), "--uninstall",
            "--prefix", str(CFG.path.parent)]
    label = os.environ.get("AUDIO_DOWNLOADER_LABEL", "")
    if label:
        argv += ["--label", label]
    if purge_music:
        argv.append("--purge-music")
    if remove_deps:
        argv.append("--remove-deps")

    # A hand-rolled install can keep the engine outside the support folder, so
    # tell the script where the pieces actually are rather than let it guess.
    env = dict(os.environ)
    env["AD_UNINSTALL_RECORD_AUDIO"] = str(RECORD_AUDIO)
    env["AD_UNINSTALL_PYTHON"] = sys.executable
    if getattr(CFG, "multiout", ""):
        env["AD_UNINSTALL_MULTIOUT"] = str(CFG.multiout)

    logpath = Path(tmpdir) / "uninstall.log"
    applog(f"uninstall requested (purge_music={purge_music}, "
           f"remove_deps={remove_deps}) -> {logpath}")
    try:
        fh = open(logpath, "wb")
        subprocess.Popen(argv, stdout=fh, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, cwd="/", env=env,
                         start_new_session=True)
    except Exception as e:
        return False, f"could not start the uninstaller: {type(e).__name__}: {e}"
    return True, str(logpath)


def self_restart():
    """Bounce our own launchd job so the new config is live. If we are not
    running under launchd, just exit -- whatever supervises us restarts us."""
    # The launchd job sets AUDIO_DOWNLOADER_LABEL in its plist. Without it we
    # cannot know which job owns us, so we just exit and let the supervisor
    # (launchd KeepAlive, or a shell) bring us back.
    label = os.environ.get("AUDIO_DOWNLOADER_LABEL", "")
    def go():
        time.sleep(0.6)
        if label:
            r = subprocess.run(["launchctl", "kickstart", "-k",
                                f"gui/{os.getuid()}/{label}"], capture_output=True)
            if r.returncode == 0:
                return
        os._exit(0)
    threading.Thread(target=go, daemon=True).start()


# ------------------------------------------------------------ submit pipeline

SUBMITS = []            # newest-first log of what this app has fired
SUBMIT_LOCK = threading.Lock()
FIRE_LOCK = threading.Lock()


def classify(url: str):
    u = url.strip()
    if u.startswith("spotify:"):
        host = "open.spotify.com"
    else:
        host = (urlparse(u).hostname or "").lower()
    if host not in ALLOWED:
        return None, None
    src = "spotify" if "spotify" in host else ("youtube" if "you" in host else "soundcloud")
    kind = "track"
    m = SPOTIFY_KIND_RE.search(u)
    if m:
        kind = m.group(1) or m.group(2)
    elif src == "spotify":
        kind = "link"     # short spotify.link — record-audio resolves it
    elif "list=" in u or "/sets/" in u:
        kind = "playlist"
    return src, kind


def fire(url: str, entry: dict):
    """Run record-audio for one URL, serialized so two adds can't race the pidlock."""
    with FIRE_LOCK:
        was_busy = current_pid() is not None
        try:
            r = subprocess.run(
                RECORD_AUDIO_CMD + [url],
                capture_output=True, text=True, timeout=60,
            )
            out = (r.stdout or "").strip() or (r.stderr or "").strip()
            entry["result"] = out[:200] or f"rc={r.returncode}"
            entry["status"] = "queued" if was_busy else "capturing"
            applog(f"fired {url} -> rc={r.returncode} {out!r}")
        except subprocess.TimeoutExpired:
            entry["status"] = "error"
            entry["result"] = "record-audio did not return within 60s"
            applog(f"fired {url} -> TIMEOUT")
        except Exception as e:
            entry["status"] = "error"
            entry["result"] = f"{type(e).__name__}: {e}"
            applog(f"fired {url} -> {type(e).__name__}: {e}")
        if not was_busy:
            for _ in range(60):          # let the worker take the pidlock
                if current_pid():
                    break
                time.sleep(0.1)


def submit(text: str):
    found, seen = [], set()
    for raw in URL_RE.findall(text or ""):
        u = raw.rstrip(".,);")
        if u in seen:
            continue
        seen.add(u)
        src, kind = classify(u)
        if not src:
            found.append({"url": u, "status": "rejected",
                          "result": "not a Spotify / YouTube / SoundCloud link",
                          "src": None, "kind": None, "t": time.time()})
            continue
        found.append({"url": u, "status": "sending", "result": "",
                      "src": src, "kind": kind, "t": time.time()})
    with SUBMIT_LOCK:
        for e in found:
            SUBMITS.insert(0, e)
        del SUBMITS[60:]
    for e in found:
        if e["status"] == "sending":
            threading.Thread(target=fire, args=(e["url"], e), daemon=True).start()
    return found


def watch_submits():
    """Resolve in-flight submits once the engine goes idle.

    record-audio drains its own queue serially, so when the pidlock clears AND
    the queue file is empty, everything this app fired has finished. Per-URL
    attribution is only exact when a single submit was in flight; with several
    we mark them finished without inventing per-item counts."""
    while True:
        time.sleep(1.5)
        try:
            with SUBMIT_LOCK:
                actives = [e for e in SUBMITS if e.get("status") in ("capturing", "queued")]
            if not actives:
                continue
            if current_pid() or queue_load():
                continue
            lines = read_log_lines()
            t0 = min(e["t"] for e in actives) - 3
            rel = [m for ts, m in lines if ts >= t0]
            # Keep the paths, not just the counts. A skip used to report only
            # "already on disk — skipped" against the raw URL, which is
            # indistinguishable from a failure: you cannot tell what it
            # matched, and because a skip does not touch the file's mtime the
            # track may be far too old to appear in the Finished list.
            done_paths = [m.group(1) for m in (DONE_RE.match(x) for x in rel) if m]
            skip_paths = [m.group(1) for m in (SKIP_RE.match(x) for x in rel) if m]
            done, skip = len(done_paths), len(skip_paths)
            summary, one_path = "", None
            if len(actives) == 1:
                if done and skip:
                    summary = f"{done} captured, {skip} already on disk"
                elif done == 1:
                    summary = f"captured {pretty_title(done_paths[0])}"
                    one_path = done_paths[0]
                elif done:
                    summary = f"{done} captured"
                elif skip == 1:
                    summary = f"{pretty_title(skip_paths[0])} — already on disk, kept"
                    one_path = skip_paths[0]
                elif skip:
                    summary = f"{skip} already on disk — skipped"
            with SUBMIT_LOCK:
                for e in actives:
                    e["status"] = "skipped" if (len(actives) == 1 and skip and not done) else "done"
                    e["result"] = summary
                    if one_path:
                        e["path"] = one_path
                    e["finished"] = time.time()
            applog(f"resolved {len(actives)} submit(s): done={done} skip={skip}")
        except Exception as exc:
            applog(f"watch_submits error: {type(exc).__name__}: {exc}")


def pretty_path(p) -> str:
    s = str(p)
    h = str(Path.home())
    return "~" + s[len(h):] if s.startswith(h) else s


def status_payload():
    cap = capture_progress()
    q = queue_load()
    with SUBMIT_LOCK:
        subs = [dict(e) for e in SUBMITS[:12]]
    return {
        "capturing": cap is not None,
        "now": cap,
        "queue": [{"url": it.get("url", ""), "label": it.get("label", "")} for it in q],
        "submits": subs,
        "recent": recent_files(),
        "storage": str(STORAGE),
        "storage_pretty": pretty_path(STORAGE),
        "mirrors": [pretty_path(m) for m in (CFG.mirror_captures, CFG.mirror_downloads) if m],
        "config_path": str(CFG.path),
        "time": datetime.now().strftime("%-I:%M:%S %p"),
    }


