<script>
const $ = s => document.querySelector(s);
const esc = s => (s||"").replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const mmss = s => { s = Math.max(0, Math.round(s||0));
  return Math.floor(s/60) + ":" + String(s%60).padStart(2,"0"); };

async function post(path, body){
  const r = await fetch(path, {method:"POST", headers:{"Content-Type":"application/json"},
                              body: JSON.stringify(body||{})});
  return r.json();
}

$("#f").addEventListener("submit", async e => {
  e.preventDefault();
  const t = $("#u").value.trim();
  if(!t) return;
  $("#u").value = "";
  await post("/api/add", {text: t});
  tick();
});

// paste a link anywhere -> straight into the box
document.addEventListener("paste", e => {
  if(document.activeElement === $("#u")) return;
  const t = (e.clipboardData||window.clipboardData).getData("text");
  if(t && /spotify|youtu|soundcloud/i.test(t)){ $("#u").value = t; $("#f").requestSubmit(); }
});
["dragover","dragenter"].forEach(ev => $("#u").addEventListener(ev, e => {
  e.preventDefault(); $("#u").classList.add("drag"); }));
["dragleave","drop"].forEach(ev => $("#u").addEventListener(ev, e =>
  $("#u").classList.remove("drag")));
$("#u").addEventListener("drop", e => {
  e.preventDefault();
  const t = e.dataTransfer.getData("text/uri-list") || e.dataTransfer.getData("text");
  if(t){ $("#u").value = t; $("#f").requestSubmit(); }
});
$("#u").addEventListener("keydown", e => {
  if(e.key === "Enter" && !e.shiftKey){ e.preventDefault(); $("#f").requestSubmit(); }
});
let toastT = null;
function toast(msg, bad){
  const t = $("#toast");
  t.textContent = msg;
  t.className = "on" + (bad ? " bad" : "");
  clearTimeout(toastT);
  toastT = setTimeout(() => t.className = "", 2200);
}

async function reveal(path, select){
  try{
    const r = await post("/api/reveal", {path: path, select: select !== false});
    toast(r.ok ? (select === false ? "Folder opened" : "Revealed in Finder") : r.msg, !r.ok);
  }catch(e){ toast("couldn't reach the app", true); }
}

$("#openfolder").addEventListener("click", () => reveal(null, false));

// ---------------------------------------------------------------- settings
let CFG_FIELDS = [];

function dzFill(d){
  const find = k => (d.fields || []).find(f => f.key === k) || {};
  const store = find("storage_dir").resolved || "";
  const dev = find("multi_output_name").value || "Multi-Output";
  $("#dzstore").textContent = store ? "(" + store + ")" : "";
  $("#dzdev").textContent = dev;
}

// ------------------------------------------------------------- first-run
const PERM_ICON = {ok:"\u2705", denied:"\u274c", unknown:"\u2753"};
function permRender(d){
  $("#permrows").innerHTML = d.items.map(p => `
    <div class="prm ${p.status === "ok" ? "ok" : ""}">
      <div class="st">${PERM_ICON[p.status] || "?"}</div>
      <div class="bd"><div class="nm">${esc(p.label)}</div>
        <div class="hp">${esc(p.help)}</div></div>
      <div class="ac">
        ${p.key === "spotify" ? `<button class="mini" data-chk="${p.key}">Check</button>` : ""}
        <button class="mini${p.status === "ok" ? "" : " go"}" data-open="${p.key}">Open</button>
      </div>
    </div>`).join("");
  $("#permrows").querySelectorAll("button[data-open]").forEach(b =>
    b.addEventListener("click", async () => {
      const r = await post("/api/perms/open", {key: b.dataset.open});
      toast(r.ok ? "System Settings opened \u2014 flip it on, then Re-check" : r.msg, !r.ok);
    }));
  $("#permrows").querySelectorAll("button[data-chk]").forEach(b =>
    b.addEventListener("click", async () => {
      b.disabled = true; const w = b.textContent; b.textContent = "\u2026";
      try { permRender(await post("/api/perms/check", {key: b.dataset.chk})); }
      catch(e){ toast("check failed", true); b.disabled = false; b.textContent = w; }
    }));
  $("#setup").hidden = !(d.show || SETUP_FORCED);
  if (d.all_ok && SETUP_FORCED) toast("all three are on \u2014 you're set");
}
let SETUP_FORCED = false;
async function permLoad(force){
  if (force) SETUP_FORCED = true;
  try { permRender(await (await fetch("/api/perms", {cache:"no-store"})).json()); }
  catch(e){ }
}

function cfgRender(d){
  CFG_FIELDS = d.fields;
  dzFill(d);
  const devs = d.devices || [];
  const rows = d.fields.map(f => {
    const id = "cf_" + f.key.replace(/\./g, "_");
    let input;
    if (f.kind === "device" && devs.length){
      const opts = devs.map(x =>
        `<option${x === f.value ? " selected" : ""}>${esc(x)}</option>`).join("");
      const miss = devs.includes(f.value) ? "" :
        `<option selected>${esc(f.value)}</option>`;
      input = `<select id="${id}" data-key="${esc(f.key)}">${miss}${opts}</select>`;
    } else {
      input = `<input id="${id}" data-key="${esc(f.key)}" spellcheck="false"
        value="${esc(f.value)}" placeholder="${f.kind === "path?" ? "blank = off" : ""}">`;
      if (f.kind === "path" || f.kind === "path?"){
        // A real Finder picker beats hand-typing a path into a text box.
        const mode = f.key === "log_file" ? "file" : "folder";
        input = `<div class="prow">${input}<button class="mini" type="button"
          data-pick="${esc(id)}" data-mode="${mode}">Browse…</button></div>`;
      }
    }
    return `<div class="fld" data-f="${esc(f.key)}">
      <label for="${id}">${esc(f.label)}</label>
      <div class="hint">${esc(f.help)}</div>${input}</div>`;
  }).join("");
  $("#cfgcard").innerHTML = rows + `
    <div class="cfgbar">
      <button class="mini go" id="cfgsave" type="button">Save</button>
      <button class="mini" id="cfgreset" type="button">Revert</button>
      <div class="sp"></div>
      <span class="where" title="${esc(d.path)}">${esc(d.path)}</span>
    </div>`;
  $("#cfgcard").querySelectorAll("input,select").forEach(el => {
    el.addEventListener("input", () => {
      const f = CFG_FIELDS.find(x => x.key === el.dataset.key);
      el.closest(".fld").classList.toggle("dirty", f && el.value !== f.value);
    });
  });
  $("#cfgcard").querySelectorAll("button[data-pick]").forEach(btn => {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.dataset.pick);
      btn.disabled = true; const was = btn.textContent; btn.textContent = "…";
      try {
        const r = await post("/api/pick", {mode: btn.dataset.mode, start: el.value});
        if (r.ok && r.path){
          el.value = r.path;
          el.dispatchEvent(new Event("input"));
        } else if (!r.ok && r.msg){ toast(r.msg, true); }
      } catch(e){ toast("picker failed", true); }
      btn.disabled = false; btn.textContent = was;
    });
  });
  $("#cfgsave").addEventListener("click", cfgSave);
  $("#cfgreset").addEventListener("click", cfgLoad);
}

async function cfgLoad(){
  try {
    cfgRender(await (await fetch("/api/config")).json());
  } catch(e){
    $("#cfgcard").innerHTML = `<div class="empty">couldn't read config</div>`;
  }
}

async function cfgSave(){
  const values = {};
  $("#cfgcard").querySelectorAll("input,select").forEach(el => {
    const f = CFG_FIELDS.find(x => x.key === el.dataset.key);
    if (f && el.value !== f.value) values[el.dataset.key] = el.value;
  });
  if (!Object.keys(values).length) return toast("nothing changed");
  const btn = $("#cfgsave"); btn.disabled = true; btn.textContent = "Saving…";
  const r = await post("/api/config", {values: values});
  btn.disabled = false; btn.textContent = "Save";
  toast(r.msg, !r.ok);
  if (r.ok && r.restart){
    // our own server is bouncing -- wait for it to answer again, then reload
    setTimeout(async function wait(n){
      for (let i = 0; i < 40; i++){
        try { const h = await fetch("/health", {cache:"no-store"});
              if (h.ok) return location.reload(); } catch(e){}
        await new Promise(r2 => setTimeout(r2, 400));
      }
      location.reload();
    }, 900);
  } else if (r.ok){
    cfgLoad();
  }
}

