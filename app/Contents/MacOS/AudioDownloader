#!/bin/bash
# Audio Downloader launcher: make sure the local server is up, then open the UI
# in a chromeless window. Port comes from the config file, not a hardcode.
SUPPORT="$HOME/Library/Application Support/Audio Downloader"
LABEL="com.audiodownloader.server"
UID_N=$(id -u)

PORT=$(/usr/bin/python3 -c "
import json,sys
try: print(json.load(open('$SUPPORT/config.json'))['server']['port'])
except Exception: print(8765)" 2>/dev/null)
[ -n "$PORT" ] || PORT=8765
URL="http://localhost:$PORT"

if ! launchctl print "gui/$UID_N/$LABEL" >/dev/null 2>&1; then
  launchctl bootstrap "gui/$UID_N" "$HOME/Library/LaunchAgents/$LABEL.plist" 2>/dev/null
else
  curl -s -m 1 "$URL/health" >/dev/null 2>&1 || launchctl kickstart "gui/$UID_N/$LABEL" 2>/dev/null
fi

for _ in $(seq 1 60); do
  curl -s -m 1 "$URL/health" >/dev/null 2>&1 && break
  sleep 0.25
done

# Open a chromeless window.
#
# NOT via `open -na "Google Chrome" --args --app=...`. When Chrome is already
# running, that hands the arguments to the running instance, which drops --app
# and starts with --no-startup-window: a process appears, a window never does.
# Launching the binary directly with its own --user-data-dir gives a genuinely
# separate instance that honours --app whether or not the user's normal Chrome
# is open. The profile sits under $SUPPORT so uninstall takes it along.
open_in() {   # $1 = app bundle path
  exe=$(/usr/bin/defaults read "$1/Contents/Info" CFBundleExecutable 2>/dev/null)
  [ -n "$exe" ] || return 1
  bin="$1/Contents/MacOS/$exe"
  [ -x "$bin" ] || return 1
  "$bin" --app="$URL" \
         --user-data-dir="$SUPPORT/browser-profile" \
         --window-size=820,940 \
         --no-first-run --no-default-browser-check >/dev/null 2>&1 &
  for _ in 1 2 3 4 5 6 7 8; do
    sleep 0.5
    pgrep -f -- "--app=$URL" >/dev/null 2>&1 && return 0
  done
  return 1
}

# Browser preference. Safari first — it is already running on most Macs, uses
# the least RAM, and keeps the launcher's shutdown of other heavy browsers off
# the critical path. Chrome / Edge fall through only if Safari isn't present
# (so an uninstall of Safari still leaves the app usable).
PREFER="${AUDIO_DOWNLOADER_BROWSER:-safari}"

open_safari() {
  [ -d "/Applications/Safari.app" ] || return 1
  /usr/bin/open -a Safari "$URL"
}

case "$PREFER" in
  safari)
    open_safari && exit 0
    open_in "/Applications/Google Chrome.app" && exit 0
    open_in "/Applications/Microsoft Edge.app" && exit 0 ;;
  chrome)
    open_in "/Applications/Google Chrome.app" && exit 0
    open_in "/Applications/Microsoft Edge.app" && exit 0
    open_safari && exit 0 ;;
  edge)
    open_in "/Applications/Microsoft Edge.app" && exit 0
    open_in "/Applications/Google Chrome.app" && exit 0
    open_safari && exit 0 ;;
esac

# Fallback: whatever the system default browser is.
open "$URL"
